# Hospital Readmission Analytics Mart - Environment Configuration
# Copy this file to .env and customize your database credentials

# Option 1: Docker Compose PostgreSQL container
DATABASE_URL=postgresql+psycopg2://postgres:hospital_secure_password123@localhost:5432/hospital_mart

# Option 2: Native Windows PostgreSQL service (replace YOUR_PASSWORD)
# DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/hospital_mart

# Option 3: If DATABASE_URL is commented out / unset, the pipeline defaults to local SQLite at db/hospital_mart.db
